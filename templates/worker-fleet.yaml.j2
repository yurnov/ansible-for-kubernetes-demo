# Deployment-managed workers: pod names are GENERATED (worker-fleet-xxxx-yyyy),
# so a static inventory cannot know them. Playbook 04 discovers them at runtime.
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker-fleet
  namespace: {{ kube_namespace }}
  labels:
    app: worker-fleet
spec:
  replicas: {{ fleet_replicas | default(2) }}
  selector:
    matchLabels:
      app: worker-fleet
  template:
    metadata:
      labels:
        app: worker-fleet
    spec:
      containers:
        - name: worker
          image: python:3.12-slim
          command: ["sleep", "infinity"]
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 128Mi
