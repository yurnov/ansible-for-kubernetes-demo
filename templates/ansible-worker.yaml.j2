# A long-running pod with Python inside — our "managed host".
# In real life this could be your app's toolbox/job pod, a debug sidecar,
# or a maintenance container that ships with your workload.
---
apiVersion: v1
kind: Pod
metadata:
  name: ansible-worker
  namespace: {{ kube_namespace }}
  labels:
    app: ansible-worker
spec:
  containers:
    - name: worker
      image: python:3.12-slim
      command: ["sleep", "infinity"]
      resources:
        requests:
          cpu: 10m
          memory: 64Mi
        limits:
          memory: 128Mi
